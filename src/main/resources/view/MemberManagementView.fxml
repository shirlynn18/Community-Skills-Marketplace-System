<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.65" 
           prefHeight="600.0" prefWidth="900.0" 
           stylesheets="@../css/style.css" 
           xmlns="http://javafx.com/javafx/21" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="controller.MemberManagementController">
    <!-- Left Pane: Table and Filters -->
    <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: -background;">
        <!-- Header -->
        <VBox spacing="5.0">
            <Label text="Member Management" styleClass="section-title" style="-fx-font-size: 20px;"/>
            <Label text="Register, edit, and view all member profiles and their credit balances." style="-fx-font-size: 13px; -fx-text-fill: -ink-soft;" />
        </VBox>

        <!-- Stats Header row -->
        <HBox spacing="20.0" style="-fx-background-color: -surface-alt; -fx-padding: 8; -fx-background-radius: 4px; -fx-border-color: -line; -fx-border-radius: 4px;">
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Total Members:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatTotal" text="0" style="-fx-text-fill: -teal; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Active Members:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatActive" text="0" style="-fx-text-fill: -mustard; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Total Credit Pool:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatCredits" text="0" style="-fx-text-fill: -teal; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
        </HBox>
        
        <!-- Search and Filters Bar -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" 
                       promptText="Search by name or contact..." 
                       HBox.hgrow="ALWAYS" 
                       style="-fx-padding: 8;"/>
            <ComboBox fx:id="cmbAreaFilter" 
                      promptText="All Areas"/>
            <Button fx:id="btnClearSearch" 
                    text="Reset Filters" 
                    onAction="#handleClearFilters" 
                    styleClass="button-neutral"
                    style="-fx-padding: 8 16;"/>
        </HBox>
        
        <!-- Table -->
        <TableView fx:id="tblMembers" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Member ID" prefWidth="90.0" styleClass="col-align-center" />
                <TableColumn fx:id="colName" text="Name" prefWidth="180.0" styleClass="col-align-left" />
                <TableColumn fx:id="colContact" text="Phone Number" prefWidth="130.0" styleClass="col-align-left" />
                <TableColumn fx:id="colArea" text="Area" prefWidth="110.0" styleClass="col-align-left" />
                <TableColumn fx:id="colCredits" text="Credit Balance" prefWidth="110.0" styleClass="col-align-right" />
                <TableColumn fx:id="colRegDate" text="Registration Date" prefWidth="120.0" styleClass="col-align-center" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
    
    <!-- Right Pane: Details and Editor Form -->
    <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: -surface-alt; -fx-border-color: -line; -fx-border-width: 0 0 0 1; -fx-min-width: 320px;" prefWidth="360.0">
        <VBox spacing="2.0">
            <Label text="Member Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -teal;"/>
            <Label fx:id="lblModeSubtitle" text="Create Mode" style="-fx-font-size: 12px; -fx-text-fill: -ink-soft; -fx-font-weight: bold;"/>
        </VBox>
        
        <GridPane hgap="10.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="38.0" />
                <ColumnConstraints percentWidth="62.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" vgrow="NEVER" />
                <RowConstraints minHeight="30.0" vgrow="NEVER" />
                <RowConstraints minHeight="30.0" vgrow="NEVER" />
                <RowConstraints minHeight="30.0" vgrow="NEVER" />
                <RowConstraints minHeight="30.0" vgrow="NEVER" />
                <RowConstraints minHeight="30.0" vgrow="NEVER" />
            </rowConstraints>
            
            <children>
                <Label text="Member ID:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="lblDetailId" text="M001" style="-fx-text-fill: -ink; -fx-font-size: 14px; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Registered:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="lblDetailRegDate" text="20-07-2026" style="-fx-text-fill: -ink; -fx-font-size: 14px; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Name *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormName" 
                           promptText="Enter name"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                
                <Label text="Phone *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormContact" 
                           promptText="Enter phone (e.g. +60123456789)"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                
                <Label text="Area:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbFormArea" 
                           promptText="Select Area"
                           maxWidth="Infinity"
                           GridPane.rowIndex="4" GridPane.columnIndex="1" />
                
                <Label text="Credit Balance *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormCredits" 
                           promptText="Enter credit balance"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="5" GridPane.columnIndex="1" />
            </children>
        </GridPane>
        
        <!-- Action Buttons Layout -->
        <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
            <!-- Create Mode Buttons -->
            <VBox fx:id="vboxCreateButtons" spacing="10.0">
                <HBox spacing="10.0">
                    <Button text="Add Member" 
                            onAction="#handleCreate" 
                            styleClass="button-primary" 
                            style="-fx-padding: 10;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Clear Form" 
                            onAction="#handleClearForm" 
                            styleClass="button-neutral" 
                            style="-fx-padding: 10;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <!-- Edit Mode Buttons -->
            <VBox fx:id="vboxEditButtons" spacing="10.0">
                <HBox spacing="10.0">
                    <Button text="Save Changes" 
                            onAction="#handleSave" 
                            styleClass="button-secondary" 
                            style="-fx-padding: 10;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Clear Form" 
                            onAction="#handleClearForm" 
                            styleClass="button-neutral" 
                            style="-fx-padding: 10;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox spacing="10.0">
                    <Button text="New Form" 
                            onAction="#handleNewForm" 
                            styleClass="button-neutral" 
                            style="-fx-padding: 10;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Delete Member" 
                            onAction="#handleDelete" 
                            styleClass="button-destructive" 
                            style="-fx-padding: 10;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</SplitPane>
