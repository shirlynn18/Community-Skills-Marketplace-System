<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.65" 
           prefHeight="600.0" prefWidth="900.0" 
           stylesheets="@../css/style.css" 
           xmlns="http://javafx.com/javafx/21" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="controller.SkillManagementController">
    <!-- Left Pane: Table and Filters -->
    <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: -background;">
        <!-- Header -->
        <VBox spacing="5.0">
            <Label text="Skill Post Management" styleClass="section-title" style="-fx-font-size: 20px;"/>
            <Label text="Manage skill posts and monitor their availability throughout the marketplace." style="-fx-font-size: 13px; -fx-text-fill: -ink-soft;" />
        </VBox>

        <!-- Stats Header row -->
        <HBox spacing="20.0" style="-fx-background-color: -surface-alt; -fx-padding: 8; -fx-background-radius: 4px; -fx-border-color: -line; -fx-border-radius: 4px;">
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Total Posts:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatTotal" text="0" style="-fx-text-fill: -teal; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Open Posts:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatActive" text="0" style="-fx-text-fill: -mustard; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Matched Posts:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatMatched" text="0" style="-fx-text-fill: -teal; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="5.0" alignment="CENTER_LEFT">
                <Label text="Closed Posts:" style="-fx-text-fill: -ink-soft; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="lblStatClosed" text="0" style="-fx-text-fill: -brick; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>
        </HBox>
        
        <!-- Search and Filters Bar -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" 
                       promptText="Search by Skill Name or Member..." 
                       HBox.hgrow="ALWAYS" 
                       style="-fx-padding: 8;"/>
            <ComboBox fx:id="cmbTypeFilter" 
                      promptText="All Types"/>
            <ComboBox fx:id="cmbStatusFilter" 
                      promptText="All Status"/>
            <Button fx:id="btnClearFilters" 
                    text="Reset Filters" 
                    onAction="#handleClearFilters" 
                    styleClass="button-neutral"
                    style="-fx-padding: 8 16;"/>
        </HBox>
        
        <!-- Table -->
        <TableView fx:id="tblPosts" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Post ID" prefWidth="75.0" styleClass="col-align-center" />
                <TableColumn fx:id="colType" text="Type" prefWidth="80.0" styleClass="col-align-center" />
                <TableColumn fx:id="colMemberId" text="Member ID" prefWidth="85.0" styleClass="col-align-center" />
                <TableColumn fx:id="colSkillName" text="Skill Name" prefWidth="130.0" styleClass="col-align-left" />
                <TableColumn fx:id="colStatus" text="Status" prefWidth="85.0" styleClass="col-align-center" />
                <TableColumn fx:id="colCreditRate" text="Credit Rate" prefWidth="100.0" styleClass="col-align-right" />
                <TableColumn fx:id="colNeededHours" text="Needed Hours" prefWidth="100.0" styleClass="col-align-right" />
                <TableColumn fx:id="colPostDate" text="Post Date" prefWidth="105.0" styleClass="col-align-center" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
    
    <!-- Right Pane: Details and Editor Form -->
    <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: -surface-alt; -fx-border-color: -line; -fx-border-width: 0 0 0 1; -fx-min-width: 320px;" prefWidth="360.0">
        <VBox spacing="2.0">
            <Label text="Post Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -teal;"/>
            <Label fx:id="lblModeSubtitle" text="Create Mode" style="-fx-font-size: 12px; -fx-text-fill: -ink-soft; -fx-font-weight: bold;"/>
        </VBox>

        <GridPane hgap="10.0" vgap="12.0" VBox.vgrow="NEVER">
            <columnConstraints>
                <ColumnConstraints percentWidth="38.0" />
                <ColumnConstraints percentWidth="62.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="NEVER" />
            </rowConstraints>
            
            <children>
                <Label text="Post ID:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="lblDetailId" text="None" style="-fx-text-fill: -ink; -fx-font-size: 14px; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Post Date:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="lblDetailPostDate" text="20-07-2026" style="-fx-text-fill: -ink; -fx-font-size: 14px; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Post Type *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbFormType" 
                           promptText="Select Type"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>
                
                <Label text="Member ID *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbFormMemberId" 
                           promptText="Select Member"
                           GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" />
                
                <Label text="Skill Name *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormSkillName" 
                           promptText="Enter skill name"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="4" GridPane.columnIndex="1" />
                
                <Label fx:id="lblFormDescription" text="Description:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormDescription" 
                           promptText="Enter description"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="5" GridPane.columnIndex="1" />
                
                <Label text="Status:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbFormStatus" 
                           promptText="Select Status"
                           maxWidth="Infinity"
                           GridPane.rowIndex="6" GridPane.columnIndex="1" />
                
                <!-- Both conditional rows placed at rowIndex 7 to prevent double vgap bug -->
                <Label fx:id="lblFormCreditRate" text="Credit Rate/Hour *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormCreditRate" 
                           promptText="Enter credit rate/hour"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="7" GridPane.columnIndex="1" />

                <Label fx:id="lblFormHours" text="Needed Hours *:" style="-fx-text-fill: -ink-soft; -fx-font-size: 14px;" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                <TextField fx:id="txtFormHours" 
                           promptText="Enter needed hour"
                           style="-fx-padding: 8;" 
                           GridPane.rowIndex="7" GridPane.columnIndex="1" />
            </children>
        </GridPane>
        
        <!-- Action Buttons Layout -->
        <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
            <!-- Create Mode Buttons -->
            <VBox fx:id="vboxCreateButtons" spacing="10.0">
                <HBox spacing="10.0">
                    <Button text="Add Post" 
                            onAction="#handleCreate" 
                            styleClass="button-primary" 
                            style="-fx-padding: 10; -fx-pref-width: 150px;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Clear Form" 
                            onAction="#handleClearForm" 
                            styleClass="button-neutral" 
                            style="-fx-padding: 10; -fx-pref-width: 150px;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <!-- Edit Mode Buttons -->
            <VBox fx:id="vboxEditButtons" spacing="10.0">
                <HBox spacing="10.0">
                    <Button text="Save Changes" 
                            onAction="#handleSave" 
                            styleClass="button-secondary" 
                            style="-fx-padding: 10; -fx-pref-width: 150px;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnDelete" text="Delete Post" 
                            onAction="#handleDelete" 
                            styleClass="button-destructive" 
                            style="-fx-padding: 10; -fx-pref-width: 150px;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <Button text="Cancel Edit" 
                        onAction="#handleNewForm" 
                        styleClass="button-neutral" 
                        style="-fx-padding: 10;"
                        maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </VBox>
</SplitPane>
