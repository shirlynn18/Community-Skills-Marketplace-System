<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controller.ShellController" 
            prefHeight="700.0" 
            prefWidth="1050.0" 
            stylesheets="@../css/style.css">
    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: -surface-alt;">
            <MenuBar HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem text="Close" onAction="#handleClose"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="About" onAction="#handleAbout"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="Dashboard">
                    <content>
                        <fx:include fx:id="dashboard" source="DashboardView.fxml" />
                    </content>
                </Tab>
                <Tab text="Member Management">
                    <content>
                        <fx:include fx:id="memberManagement" source="MemberManagementView.fxml" />
                    </content>
                </Tab>
                <Tab text="Skill Post Management">
                    <content>
                        <fx:include fx:id="skillManagement" source="SkillManagementView.fxml" />
                    </content>
                </Tab>
                <Tab text="Service Exchange &amp; Credit Management">
                    <content>
                        <fx:include fx:id="serviceExchange" source="ServiceExchangeView.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
